# Copie para .env.local (NUNCA suba .env.local ao Git). Na Vercel, use Settings > Environment Variables.
# Requer Node 22 ou superior (exigência do SDK @google/genai).
# A IA é OPCIONAL: sem estas variáveis o Bimo funciona normalmente com o motor local.
# NUNCA use o prefixo VITE_ em chaves: ele exporia o valor no navegador.
GEMINI_API_KEY=
# Opcionais (valores padrão entre parênteses):
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low        (minimal | low | medium | high | none)
# AI_MAX_OUTPUT_TOKENS=500
# AI_RATE_PER_MINUTE=12
# AI_DAILY_LIMIT=300
# AI_TIMEOUT_MS=15000
# GEMINI_API_VERSION=v1beta
